<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.chart.BubbleChart?>
<?import javafx.scene.layout.HBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ejercicio8.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Calculadora 3 mil"/>
    <HBox alignment="CENTER" spacing="20.0">
        <VBox alignment="CENTER" spacing="20.0">
            <Label text="Numero 1"/>
            <TextField fx:id="tfNumero1"/>
        </VBox>
        <VBox alignment="CENTER" spacing="20.0">
            <Label text="Numero 2"/>
            <TextField fx:id="tfNumero2"/>
        </VBox>
    </HBox>
    <HBox alignment="CENTER" spacing="20">
        <Button text="+" onAction="#sum"/>
        <Button text="-" onAction="#substract"/>
        <Button text="*" onAction="#mutiply"/>
        <Button text="/" onAction="#divide"/>
    </HBox>
    <Label fx:id="lblResult"/>
    <Label fx:id="lblHistory"/>

</VBox>

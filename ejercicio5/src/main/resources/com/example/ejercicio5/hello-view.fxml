<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="606.0" prefWidth="496.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ejercicio5.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label text="Estudiantes:" />
   <Label fx:id="lblStudents" text="Agrega un estudiante para comenzar" />
   <TextField fx:id="tfStudent" />
   <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
      <children>
         <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#add" text="Agregar" />
         <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#search" text="Buscar" />
         <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#delete" text="Eliminar" />
         <Button fx:id="btnQuantity" mnemonicParsing="false" onAction="#getQuantity" text="Cantidad" />
      </children>
   </HBox>
   <Label fx:id="lblResult" />
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ejercicio9.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <TextField fx:id="tfElement"/>
    <HBox alignment="CENTER" spacing="20.0">
        <Button text="push" onAction="#push"/>
        <Button text="pop" onAction="#pop"/>
        <Button text="peek" onAction="#peek"/>
    </HBox>
    <Label fx:id="lblResult"/>
    <Label fx:id="lblStack"/>
    <Label fx:id="lblIsEmpty" text="Pila vacia"/>
</VBox>

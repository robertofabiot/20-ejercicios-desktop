<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ejercicio14.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TextField fx:id="productName" promptText="Nombre del producto"/>
    <TextField fx:id="productPrice" promptText="Precio"/>
    <TextField fx:id="productQuantity" promptText="Cantidad"/>
    <Button text="Registrar producto" onAction="#registerProduct"/>

    <TextField fx:id="discountInput" promptText="Porcentaje de descuento (%)"/>
    <Button text="Calcular totales" onAction="#calculateTotals"/>

    <Label text="Subtotal: " fx:id="subtotalLabel"/>
    <Label text="Descuento: " fx:id="discountLabel"/>
    <Label text="IVA (15%): " fx:id="ivaLabel"/>
    <Label text="Total: " fx:id="totalLabel"/>
</VBox>
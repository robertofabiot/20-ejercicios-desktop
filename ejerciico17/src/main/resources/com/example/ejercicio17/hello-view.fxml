<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ejercicio17.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TextField fx:id="tfBookTitle" promptText="Título del libro"/>
    <Button text="Registrar libro" onAction="#registerBook"/>
    <Button text="Buscar libro" onAction="#searchBook"/>
    <Button text="Prestar libro" onAction="#borrowBook"/>
    <Button text="Devolver libro" onAction="#returnBook"/>

    <Label text="Estado: " fx:id="lblStatus"/>
    <Label text="Libros disponibles: 0" fx:id="lblAvailableBooks"/>
</VBox>
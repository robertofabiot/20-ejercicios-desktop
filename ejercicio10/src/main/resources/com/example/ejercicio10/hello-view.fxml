<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ejercicio10.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Bienvenido al panel de hackeo"/>
    <Button text="Hackear la NASA" onAction="#hackNasa"/>
    <Button text="Entrar a la dark web" onAction="#enterDarkWek"/>
    <Button text="Borrar copilot en Windows 11" onAction="#fuckMicrosoft"/>
    <Label fx:id="lblResult" text="Ultima accion hecha: "/>
    <Label fx:id="lblCurrentOperation" text="Operacion Actual: "/>
    <Button text="Deshacer" onAction="#undo"/>
</VBox>

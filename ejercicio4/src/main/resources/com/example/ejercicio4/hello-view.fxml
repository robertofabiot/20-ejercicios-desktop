<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="577.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ejercicio4.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label text="Notas" />
      <TextField fx:id="tfGrade" />
      <Button fx:id="btnAdd" mnemonicParsing="false" text="Agregar" />
      <Label fx:id="lblAvg" text="Promedio general:" />
      <Label fx:id="lblHighestGrade" text="Nota mayor: " />
      <Label fx:id="lblLowestGrade" text="Nota menor: " />
      <Label fx:id="lblPassingStudents" text="Aprobados: " />
      <Label fx:id="lblFailingStudents" text="Reprobados: " />
   </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ejercicio13.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <Label text="Sistema de Atención a Clientes"/>
    <TextField fx:id="tfNewClient"/>
    <Button text="Agregar cliente" onAction="#addClient"/>
    <Label text="Siguiente cliente: " fx:id="lblNextClient"/>
    <Button text="Atender" onAction="#serveClient"/>
    <Label text="Clientes pendientes: " fx:id="lblPendingClients"/>
</VBox>

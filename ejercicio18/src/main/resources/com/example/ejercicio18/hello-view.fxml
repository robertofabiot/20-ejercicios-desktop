<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ejercicio18.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TextField fx:id="tfClientName" promptText="Nombre del cliente"/>
    <Button text="Registrar y Asignar Turno" onAction="#registerClient"/>
    <Button text="Atender cliente" onAction="#attendClient"/>
    <Button text="Mostrar historial" onAction="#showHistory"/>

    <Label text="Estado: " fx:id="lblStatus"/>
    <Label text="Clientes pendientes: 0" fx:id="lblPendingClients"/>
    <Label text="Historial: " fx:id="lblHistory"/>
</VBox>
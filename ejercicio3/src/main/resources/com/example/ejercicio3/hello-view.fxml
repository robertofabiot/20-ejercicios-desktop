<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="599.0" prefWidth="457.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ejercicio3.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label text="Ingresar numero" />
   <TextField fx:id="tfNumber" />
   <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#addNumber" text="Agregar" />
   <Label fx:id="originalNumbers" text="Numeros originales:" />
   <Label fx:id="sortedNumbers" text="Numeros ordenados:" />
</VBox>
